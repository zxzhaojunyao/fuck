# FUCK reads all config from ~/.fuck/config.json (never from generic env vars).
# Edit ~/.fuck/config.json manually:
#
# {
#   "provider": {
#     "tokenhub": {
#       "baseUrl": "https://tokenhub.tencentmaas.com/v1",
#       "apiKey": "sk-xxx",
#       "api": "openai-completions",
#       "models": [
#         { "id": "deepseek-v4-pro" },
#         { "id": "kimi-k3" }
#       ]
#     }
#   },
#   "model": "tokenhub/deepseek-v4-pro"
# }
#
# apiKey supports $VAR / ${VAR} / !command interpolation; the static models table is optional (auto-fetches /models).
